# Порт, на котором будет открыт сайт: http://localhost:8080
HTTP_PORT=8080

# Обязательно поменяйте! Длинная случайная строка (например: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_DB=odo
POSTGRES_USER=odo
POSTGRES_PASSWORD=change-me

# Первый администратор (создаётся, только если пользователей ещё нет)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Администратор

# Максимальный размер одного файла, ГБ
MAX_UPLOAD_GB=5

# Сколько файлов обрабатывать параллельно (конвертация видео нагружает процессор)
WORKER_THREADS=3
GUNICORN_WORKERS=3

TZ=Asia/Bishkek

# Если сайт открыт по HTTPS (через внешний прокси / домен):
# COOKIE_SECURE=true
# CSRF_TRUSTED_ORIGINS=https://odo.example.com
